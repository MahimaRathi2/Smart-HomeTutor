<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart HomeTutor</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/dist/assets/index.css">
    <script src="/socket.io/socket.io.js"></script>
    <script>
        window.__INITIAL_DATA__ = {
            isAuth: <%= typeof isAuth !== 'undefined' && isAuth ? 'true' : 'false' %>,
            userRole: "<%= (typeof userRole !== 'undefined' && userRole) ? userRole : '' %>",
            userName: "<%= (typeof userName !== 'undefined' && userName) ? userName : '' %>",
            userEmail: "<%= (typeof userEmail !== 'undefined' && userEmail) ? userEmail : '' %>",
            userId: "<%= (typeof userId !== 'undefined' && userId) ? userId : '' %>"
        };
    </script>
</head>
<body>
    <div id="root"></div>
    <script type="module" src="/dist/assets/index.js"></script>
</body>
</html>